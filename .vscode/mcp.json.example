{
  "servers": {
    "skein": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${userHome}/.vscode/extensions/sjh354.skein-*/dist/mcpServer.mjs"
      ],
      "env": {
        "WORKSPACE_ROOT": "${workspaceFolder}",
        "EXCLUDE_NODE_MODULES": "true",
        "MAX_DEPTH": "50"
      }
    }
  }
}
